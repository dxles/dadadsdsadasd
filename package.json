{
  "name": "cinla-music",
  "version": "1.0.0",
  "private": true,
  "description": "Çınla Türkçe müzik masaüstü uygulaması",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tr.cinla.music",
    "productName": "Çınla",
    "asar": true,
    "directories": {
      "output": "../cinla-windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "site",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!cinla-windows/**",
          "!dist/**",
          "!main.cjs",
          "!preload.cjs",
          "!package.json",
          "!package-lock.json",
          "!README.md",
          "!.npm-cache/**",
          "!.electron-cache/**",
          "!.builder-cache/**",
          "!downloads/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Cinla-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
